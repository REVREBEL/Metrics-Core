er gap-4'>\n              <Separator className='flex-1' />\n              <p>or</p>\n              <Separator className='flex-1' />\n            </div>\n\n            <Button variant='ghost' className='w-full' asChild>\n              <a href='#'>Sign in with google</a>\n            </Button>\n          </div>\n        </CardContent>\n      </Card>\n    </div>\n  )\n}\n\nexport default Login\n",
