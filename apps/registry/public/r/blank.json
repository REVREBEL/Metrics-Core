  "files": [
    {
      "path": "apps/registry/app/demo/[name]/blocks/minimal-layout.tsx",
      "content": "import React, { type ReactNode } from \"react\";\n\nexport default function MinimalLayout({\n  children,\n}: Readonly<{\n  children: ReactNode;\n}>) {\n  return (\n    <main className=\"mt-16 flex w-full justify-center\">\n      <div className=\"container\">{children}</div>\n    </main>\n  );\n}\n",
      "type": "registry:file",
      "target": "src/app/layout.tsx"
    },
    {
      "path": "apps/registry/app/demo/[name]/blocks/blank-page.tsx",
      "content": "export default function BlankPage() {\n  return (\n    <div className=\"flex flex-col items-center justify-center gap-4 rounded-md py-96\">\n      <div className=\"text-muted-foreground\">\n        Start prompting to use your component!\n      </div>\n    </div>\n  );\n}\n",
