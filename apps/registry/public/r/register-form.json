      "content": "'use client'\n\nimport { useState } from 'react'\n\nimport { EyeIcon, EyeOffIcon } from 'lucide-react'\n\nimport { Button } from '@ui-core'\nimport { Checkbox } from '@ui-core'\nimport { Input } from '@ui-core'\nimport { Label } from '@ui-core'\n\nconst RegisterForm = () => {\n  const [isPasswordVisible, setIsPasswordVisible] = useState(false)\n  const [isConfirmPasswordVisible, setIsConfirmPasswordVisible] = useState(false)\n\n  return (\n    <form className='space-y-4' onSubmit={e => e.preventDefault()}>\n      {/* Username */}\n      <div className='space-y-1'>\n        <Label className='leading-5' htmlFor='username'>\n          Username*\n        </Label>\n        <Input type='text' id='username' placeholder='Enter your username' />\n      </div>\n\n      {/* Email */}\n      <div className='space-y-1'>\n        <Label className='leading-5' htmlFor='userEmail'>\n          Email address*\n        </Label>\n        <Input type='email' id='userEmail' placeholder='Enter your email address' />\n      </div>\n\n      {/* Password */}\n      <div className='w-full space-y-1'>\n        <Label className='leading-5' htmlFor='password'>\n          Password*\n        </Label>\n        <div className='relative'>\n          <Input\n            id='password'\n            type={isPasswordVisible ? 'text' : 'password'}\n            placeholder='••••••••••••••••'\n            className='pr-9'\n          />\n          <Button\n            variant='ghost'\n            size='icon'\n            onClick={() => setIsPasswordVisible(prevState => !prevState)}\n            className='text-muted-foreground focus-visible:ring-ring/50 absolute inset-y-0 right-0 rounded-l-none hover:bg-transparent'\n          >\n            {isPasswordVisible ? <EyeOffIcon /> : <EyeIcon />}\n            <span className='sr-only'>{isPasswordVisible ? 'Hide password' : 'Show password'}</span>\n          </Button>\n        </div>\n      </div>\n\n      {/* Confirm Password */}\n      <div className='w-full space-y-1'>\n        <Label className='leading-5' htmlFor='confirmPassword'>\n          Confirm Password*\n        </Label>\n        <div className='relative'>\n          <Input\n            id='confirmPassword'\n            type={isConfirmPasswordVisible ? 'text' : 'password'}\n            placeholder='••••••••••••••••'\n            className='pr-9'\n          />\n          <Button\n            variant='ghost'\n            size='icon'\n            onClick={() => setIsConfirmPasswordVisible(prevState => !prevState)}\n            className='text-muted-foreground focus-visible:ring-ring/50 absolute inset-y-0 right-0 rounded-l-none hover:bg-transparent'\n          >\n            {isConfirmPasswordVisible ? <EyeOffIcon /> : <EyeIcon />}\n            <span className='sr-only'>{isConfirmPasswordVisible ? 'Hide password' : 'Show password'}</span>\n          </Button>\n        </div>\n      </div>\n\n      {/* Privacy policy */}\n      <div className='flex items-center gap-3'>\n        <Checkbox id='rememberMe' className='size-6' />\n        <Label htmlFor='rememberMe'>\n          <span className='text-muted-foreground'>I agree to</span> <a href='#'>privacy policy & terms</a>\n        </Label>\n      </div>\n\n      <Button className='w-full' type='submit'>\n        Sign Up to Shadcn Studio\n      </Button>\n    </form>\n  )\n}\n\nexport default RegisterForm\n",
