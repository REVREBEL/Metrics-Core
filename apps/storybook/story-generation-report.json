from pathlib import Path
import textwrap, json, zipfile

base = Path("/mnt/data/metrics-story-generator")
(base / "apps/storybook/scripts").mkdir(parents=True, exist_ok=True)
(base / "apps/docs/src/content/storybook").mkdir(parents=True, exist_ok=True)

script = r'''#!/usr/bin/env node

import { createHash } from "node:crypto";
import { existsSync } from "node:fs";
import {
  mkdir,
  readFile,
  readdir,
  stat,
  writeFile,
} from "node:fs/promises";
import { dirname, extname, relative, resolve, sep } from "node:path";
import { fileURLToPath } from "node:url";
import ts from "typescript";

const GENERATED_MARKER = "// @generated by Metrics Storybook story generator";
const SOURCE_HASH_PREFIX = "// @source-hash: ";
const DEFAULT_REPORT = "apps/storybook/story-generation-report.json";

const scriptDir = dirname(fileURLToPath(import.meta.url));
const repoRoot = resolve(scriptDir, "../../..");

const defaultRoots = [
  resolve(repoRoot, "packages/ui/src/primitives"),
  resolve(repoRoot, "packages/ui/src/components"),
];

const ignoredDirectoryNames = new Set([
  "node_modules",
  "dist",
  "build",
  ".next",
  "storybook-static",
  "__tests__",
  "fixtures",
  "demo",
  "generated",
]);

const ignoredFilePatterns = [
  /\.stories\.[cm]?[jt]sx?$/,
  /\.test\.[cm]?[jt]sx?$/,
  /\.spec\.[cm]?[jt]sx?$/,
  /\.d\.ts$/,
  /(?:^|\/)index\.[cm]?[jt]sx?$/,
  /(?:^|\/)metadata\.[cm]?[jt]sx?$/,
];

const unsafeRequiredPropNames = new Set([
  "schema",
  "columns",
  "renderItem",
  "renderCell",
  "router",
  "client",
  "session",
  "auth",
  "api",
  "config",
]);

const familyRules = [
  ["button", /(?:^|\/)(?:buttons?|button)(?:\/|$)/i],
  ["textarea", /(?:^|\/)textareas?(?:\/|$)/i],
  ["select", /(?:^|\/)selects?(?:\/|$)/i],
  ["checkbox", /(?:^|\/)checkbox(?:es)?(?:\/|$)/i],
  ["switch", /(?:^|\/)switch(?:es)?(?:\/|$)/i],
  ["badge", /(?:^|\/)badges?(?:\/|$)/i],
  ["card", /(?:^|\/)cards?(?:\/|$)/i],
  ["tabs", /(?:^|\/)tabs?(?:\/|$)/i],
  ["popover", /(?:^|\/)popovers?(?:\/|$)/i],
  ["dialog", /(?:^|\/)dialogs?(?:\/|$)/i],
  ["chart", /(?:^|\/)charts?(?:\/|$)/i],
  ["table", /(?:^|\/)(?:tables?|data-grid)(?:\/|$)/i],
  ["metric", /(?:^|\/)metrics-core(?:\/|$)/i],
  ["layout", /(?:^|\/)(?:layouts?|metrics-layouts)(?:\/|$)/i],
  ["typography", /(?:^|\/)typography(?:\/|$)/i],
  ["input", /(?:^|\/)inputs?(?:\/|$)/i],
];

function parseArgs(argv) {
  const options = {
    check: false,
    dryRun: false,
    force: false,
    report: DEFAULT_REPORT,
    folder: null,
    component: null,
    help: false,
  };

  for (let index = 0; index < argv.length; index += 1) {
    const value = argv[index];

    switch (value) {
      case "--check":
        options.check = true;
        break;
      case "--dry-run":
        options.dryRun = true;
        break;
      case "--force":
        options.force = true;
        break;
      case "--folder":
        options.folder = argv[++index] ?? null;
        break;
      case "--component":
        options.component = argv[++index] ?? null;
        break;
      case "--report":
        options.report = argv[++index] ?? DEFAULT_REPORT;
        break;
      case "--help":
      case "-h":
        options.help = true;
        break;
      default:
        throw new Error(`Unknown option: ${value}`);
    }
  }

  return options;
}

function printHelp() {
  console.log(`
Metrics Storybook story generator

Usage:
  pnpm storybook:stories:generate [options]

Options:
  --check                 Exit 1 when missing stories are found; write nothing
  --dry-run               Preview actions without writing stories
  --folder <path>         Limit scanning to a folder under packages/ui/src
  --component <name>      Limit generation to a component export or filename
  --force                 Replace only unchanged generated stories
  --report <path>         Report path relative to repo root
  --help                  Show this help
`);
}

async function walk(directory) {
  if (!existsSync(directory)) {
    return [];
  }

  const entries = await readdir(directory, { withFileTypes: true });
  const files = [];

  for (const entry of entries) {
    if (entry.isDirectory()) {
      if (ignoredDirectoryNames.has(entry.name)) {
        continue;
      }

      files.push(...(await walk(resolve(directory, entry.name))));
      continue;
    }

    if (!entry.isFile()) {
      continue;
    }

    const filePath = resolve(directory, entry.name);
    const normalized = toPosix(relative(repoRoot, filePath));

    if (!/\.[cm]?[jt]sx?$/.test(entry.name)) {
      continue;
    }

    if (extname(entry.name) !== ".tsx" && extname(entry.name) !== ".jsx") {
      continue;
    }

    if (ignoredFilePatterns.some((pattern) => pattern.test(normalized))) {
      continue;
    }

    files.push(filePath);
  }

  return files;
}

function toPosix(value) {
  return value.split(sep).join("/");
}

function humanize(value) {
  return value
    .replace(/\.[^.]+$/, "")
    .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase())
    .trim();
}

function getNodeName(node) {
  return node?.name && ts.isIdentifier(node.name) ? node.name.text : null;
}

function hasExportModifier(node) {
  return Boolean(
    node.modifiers?.some(
      (modifier) => modifier.kind === ts.SyntaxKind.ExportKeyword,
    ),
  );
}

function looksLikeReactComponentName(name) {
  return Boolean(name && /^[A-Z][A-Za-z0-9]*$/.test(name));
}

function expressionLooksLikeComponent(initializer) {
  if (!initializer) {
    return false;
  }

  if (
    ts.isArrowFunction(initializer) ||
    ts.isFunctionExpression(initializer)
  ) {
    return true;
  }

  if (ts.isCallExpression(initializer)) {
    const expressionText = initializer.expression.getText();
    return /(forwardRef|memo|createContext)$/.test(expressionText);
  }

  return false;
}

function functionReturnsJsx(node) {
  if (!node.body) {
    return false;
  }

  let found = false;

  const inspect = (child) => {
    if (
      ts.isJsxElement(child) ||
      ts.isJsxSelfClosingElement(child) ||
      ts.isJsxFragment(child)
    ) {
      found = true;
      return;
    }

    if (!found) {
      ts.forEachChild(child, inspect);
    }
  };

  ts.forEachChild(node.body, inspect);
  return found;
}

function collectTopLevelDeclarations(sourceFile) {
  const declarations = new Map();
  const directlyExported = new Set();
  const namedExports = new Set();

  for (const statement of sourceFile.statements) {
    if (ts.isFunctionDeclaration(statement)) {
      const name = getNodeName(statement);
      if (name) {
        declarations.set(name, statement);
        if (hasExportModifier(statement)) {
          directlyExported.add(name);
        }
      }
    }

    if (ts.isClassDeclaration(statement)) {
      const name = getNodeName(statement);
      if (name) {
        declarations.set(name, statement);
        if (hasExportModifier(statement)) {
          directlyExported.add(name);
        }
      }
    }

    if (ts.isVariableStatement(statement)) {
      for (const declaration of statement.declarationList.declarations) {
        const name = getNodeName(declaration);
        if (!name) {
          continue;
        }

        declarations.set(name, declaration);

        if (hasExportModifier(statement)) {
          directlyExported.add(name);
        }
      }
    }

    if (
      ts.isExportDeclaration(statement) &&
      statement.exportClause &&
      ts.isNamedExports(statement.exportClause) &&
      !statement.moduleSpecifier
    ) {
      for (const element of statement.exportClause.elements) {
        namedExports.add(element.name.text);
      }
    }
  }

  return {
    declarations,
    exportedNames: new Set([...directlyExported, ...namedExports]),
  };
}

function isVisualComponentDeclaration(node) {
  if (ts.isFunctionDeclaration(node)) {
    return functionReturnsJsx(node);
  }

  if (ts.isClassDeclaration(node)) {
    return Boolean(
      node.heritageClauses?.some((clause) =>
        clause.types.some((type) =>
          /(Component|PureComponent)/.test(type.expression.getText()),
        ),
      ),
    );
  }

  if (ts.isVariableDeclaration(node)) {
    return expressionLooksLikeComponent(node.initializer);
  }

  return false;
}

function findPropsTypeNode(declaration) {
  if (ts.isFunctionDeclaration(declaration)) {
    return declaration.parameters[0]?.type ?? null;
  }

  if (ts.isVariableDeclaration(declaration)) {
    const initializer = declaration.initializer;

    if (
      initializer &&
      (ts.isArrowFunction(initializer) || ts.isFunctionExpression(initializer))
    ) {
      return initializer.parameters[0]?.type ?? null;
    }

    if (initializer && ts.isCallExpression(initializer)) {
      return initializer.typeArguments?.[0] ?? null;
    }
  }

  return null;
}

function collectTypeDeclarations(sourceFile) {
  const types = new Map();

  for (const statement of sourceFile.statements) {
    if (ts.isInterfaceDeclaration(statement) || ts.isTypeAliasDeclaration(statement)) {
      types.set(statement.name.text, statement);
    }
  }

  return types;
}

function literalUnionValues(node) {
  if (!node || !ts.isUnionTypeNode(node)) {
    return [];
  }

  const values = [];

  for (const type of node.types) {
    if (ts.isLiteralTypeNode(type)) {
      if (ts.isStringLiteral(type.literal)) {
        values.push(type.literal.text);
      } else if (
        type.literal.kind === ts.SyntaxKind.TrueKeyword ||
        type.literal.kind === ts.SyntaxKind.FalseKeyword
      ) {
        values.push(type.literal.kind === ts.SyntaxKind.TrueKeyword);
      }
    }
  }

  return values;
}

function typeNodeToProps(typeNode, typeDeclarations, sourceFile, seen = new Set()) {
  if (!typeNode) {
    return [];
  }

  if (ts.isTypeLiteralNode(typeNode)) {
    return membersToProps(typeNode.members, sourceFile);
  }

  if (ts.isTypeReferenceNode(typeNode) && ts.isIdentifier(typeNode.typeName)) {
    const typeName = typeNode.typeName.text;

    if (seen.has(typeName)) {
      return [];
    }

    seen.add(typeName);
    const declaration = typeDeclarations.get(typeName);

    if (ts.isInterfaceDeclaration(declaration)) {
      return membersToProps(declaration.members, sourceFile);
    }

    if (ts.isTypeAliasDeclaration(declaration)) {
      return typeNodeToProps(
        declaration.type,
        typeDeclarations,
        sourceFile,
        seen,
      );
    }
  }

  if (ts.isIntersectionTypeNode(typeNode)) {
    return typeNode.types.flatMap((part) =>
      typeNodeToProps(part, typeDeclarations, sourceFile, seen),
    );
  }

  return [];
}

function membersToProps(members, sourceFile) {
  const props = [];

  for (const member of members) {
    if (!ts.isPropertySignature(member) || !member.name) {
      continue;
    }

    const name = member.name.getText(sourceFile).replace(/^["']|["']$/g, "");
    const type = member.type?.getText(sourceFile) ?? "unknown";
    const unionValues = literalUnionValues(member.type);
    const jsDoc = ts.getJSDocCommentsAndTags(member)
      .map((node) => node.getText(sourceFile))
      .join(" ")
      .replace(/\/\*\*|\*\/|\*/g, " ")
      .replace(/\s+/g, " ")
      .trim();

    props.push({
      name,
      type,
      required: !member.questionToken,
      unionValues,
      description: jsDoc || undefined,
    });
  }

  return props;
}

function classifyComponent(relativePath, exportName) {
  const key = `${relativePath}/${exportName}`;

  for (const [family, pattern] of familyRules) {
    if (pattern.test(key)) {
      return family;
    }
  }

  return "generic";
}

function createStoryTitle(sourcePath, exportName) {
  const relativeSource = toPosix(
    relative(resolve(repoRoot, "packages/ui/src"), sourcePath),
  );
  const folderSegments = relativeSource.split("/");
  folderSegments.pop();

  const titleSegments = folderSegments.map(humanize);
  titleSegments.push(humanize(exportName));

  return titleSegments.join("/");
}

function calculateHash(value) {
  return createHash("sha256").update(value).digest("hex").slice(0, 16);
}

function getStoryPath(sourcePath) {
  return sourcePath.replace(/\.(tsx|jsx)$/, ".stories.tsx");
}

function getImportPath(sourcePath) {
  const filename = sourcePath.split(sep).pop().replace(/\.(tsx|jsx)$/, "");
  return `./${filename}`;
}

function simpleValueForProp(prop, componentName) {
  const lower = prop.name.toLowerCase();
  const type = prop.type.replace(/\s/g, "");

  if (prop.unionValues.length > 0) {
    const safe = prop.unionValues.find(
      (value) => value !== "destructive" && value !== true,
    );
    return JSON.stringify(safe ?? prop.unionValues[0]);
  }

  if (lower === "children") {
    return JSON.stringify(humanize(componentName));
  }

  if (["title", "label", "name", "heading"].includes(lower)) {
    return JSON.stringify(humanize(componentName));
  }

  if (lower === "description") {
    return JSON.stringify("Example description");
  }

  if (
    ["disabled", "open", "checked", "selected", "loading", "isloading"].includes(
      lower,
    )
  ) {
    return "false";
  }

  if (/^(string|React\.ReactNode|ReactNode)$/.test(type)) {
    return JSON.stringify(humanize(componentName));
  }

  if (type === "number") {
    return "1";
  }

  if (/^\(.*\)=>/.test(type) || type.includes("MouseEventHandler")) {
    return "() => {}";
  }

  return null;
}

function propsByName(props) {
  return new Map(props.map((prop) => [prop.name, prop]));
}

function chartFixture(props) {
  const names = propsByName(props);
  const args = [];

  if (names.has("data")) {
    args.push(`data: [
      { month: "Jan", revenue: 120, budget: 110 },
      { month: "Feb", revenue: 145, budget: 125 },
      { month: "Mar", revenue: 138, budget: 132 },
      { month: "Apr", revenue: 164, budget: 145 },
    ]`);
  }

  if (names.has("index")) {
    args.push(`index: "month"`);
  }

  if (names.has("categories")) {
    args.push(`categories: ["revenue", "budget"]`);
  }

  return args;
}

function metricFixture(props, componentName) {
  const names = propsByName(props);
  const values = new Map([
    ["title", `"Revenue"`],
    ["label", `"Revenue"`],
    ["name", `"Revenue"`],
    ["value", `"$164K"`],
    ["description", `"Current period performance"`],
    ["change", `12.4`],
    ["trend", `"up"`],
  ]);

  return [...values]
    .filter(([name]) => names.has(name))
    .map(([name, value]) => `${name}: ${value}`);
}

function inputFixture(props) {
  const names = propsByName(props);
  const args = [];

  if (names.has("placeholder")) {
    args.push(`placeholder: "Enter a value"`);
  }

  if (names.has("type")) {
    args.push(`type: "text"`);
  }

  return args;
}

function inferArgs(component) {
  const args = [];
  const used = new Set();

  const add = (entries) => {
    for (const entry of entries) {
      const name = entry.split(":")[0].trim();
      if (!used.has(name)) {
        args.push(entry);
        used.add(name);
      }
    }
  };

  if (component.family === "chart") {
    add(chartFixture(component.props));
  } else if (component.family === "metric") {
    add(metricFixture(component.props, component.exportName));
  } else if (
    ["input", "textarea", "select", "checkbox", "switch"].includes(component.family)
  ) {
    add(inputFixture(component.props));
  }

  for (const prop of component.props) {
    if (used.has(prop.name) || prop.name === "className" || prop.name === "style") {
      continue;
    }

    const value = simpleValueForProp(prop, component.exportName);

    if (value !== null && (prop.required || ["children", "disabled"].includes(prop.name))) {
      add([`${prop.name}: ${value}`]);
    }
  }

  const unresolvedRequired = component.props.filter(
    (prop) =>
      prop.required &&
      !used.has(prop.name) &&
      !["className", "style"].includes(prop.name),
  );

  return {
    args,
    unresolvedRequired,
  };
}

function renderArgs(args, indent = "  ") {
  if (args.length === 0) {
    return "{}";
  }

  return `{\n${args
    .map((entry) =>
      entry
        .split("\n")
        .map((line) => `${indent}${line}`)
        .join("\n"),
    )
    .join(",\n")},\n}`;
}

function supportedUnionValue(component, propName, value) {
  const prop = component.props.find((candidate) => candidate.name === propName);
  return prop?.unionValues.includes(value);
}

function renderAdditionalStories(component) {
  const stories = [];

  if (component.family === "button") {
    if (supportedUnionValue(component, "variant", "secondary")) {
      stories.push(`export const Secondary: Story = {
  args: {
    variant: "secondary",
  },
};`);
    }

    if (supportedUnionValue(component, "variant", "outline")) {
      stories.push(`export const Outline: Story = {
  args: {
    variant: "outline",
  },
};`);
    }

    if (component.props.some((prop) => prop.name === "disabled")) {
      stories.push(`export const Disabled: Story = {
  args: {
    disabled: true,
  },
};`);
    }
  }

  if (["input", "textarea"].includes(component.family)) {
    if (component.props.some((prop) => prop.name === "value")) {
      stories.push(`export const WithValue: Story = {
  args: {
    value: "Example value",
  },
};`);
    }

    if (component.props.some((prop) => prop.name === "disabled")) {
      stories.push(`export const Disabled: Story = {
  args: {
    disabled: true,
  },
};`);
    }

    if (component.props.some((prop) => prop.name === "aria-invalid")) {
      stories.push(`export const Invalid: Story = {
  args: {
    "aria-invalid": true,
  },
};`);
    }
  }

  return stories.length > 0 ? `\n\n${stories.join("\n\n")}` : "";
}

function renderStory(component, sourceHash, inferred) {
  const todo =
    inferred.unresolvedRequired.length > 0
      ? `\n// TODO(story): Provide representative values for required props:\n${inferred.unresolvedRequired
          .map((prop) => `// - ${prop.name}: ${prop.type}`)
          .join("\n")}\n`
      : "\n";

  const args = renderArgs(inferred.args, "    ");

  return `${GENERATED_MARKER}
${SOURCE_HASH_PREFIX}${sourceHash}
${todo}import type { Meta, StoryObj } from "@storybook/react";

import { ${component.exportName} } from "${component.importPath}";

const meta = {
  title: "${component.title}",
  component: ${component.exportName},
  tags: ["autodocs"],
  parameters: {
    layout: "padded",
  },
  args: ${args},
} satisfies Meta<typeof ${component.exportName}>;

export default meta;

type Story = StoryObj<typeof meta>;

export const Default: Story = {};${renderAdditionalStories(component)}
`;
}

async function inspectComponentFile(sourcePath) {
  const sourceText = await readFile(sourcePath, "utf8");
  const sourceFile = ts.createSourceFile(
    sourcePath,
    sourceText,
    ts.ScriptTarget.Latest,
    true,
    ts.ScriptKind.TSX,
  );
  const { declarations, exportedNames } = collectTopLevelDeclarations(sourceFile);
  const typeDeclarations = collectTypeDeclarations(sourceFile);
  const components = [];

  for (const exportName of exportedNames) {
    const declaration = declarations.get(exportName);

    if (
      !looksLikeReactComponentName(exportName) ||
      !declaration ||
      !isVisualComponentDeclaration(declaration)
    ) {
      continue;
    }

    const propsTypeNode = findPropsTypeNode(declaration);
    const props = typeNodeToProps(propsTypeNode, typeDeclarations, sourceFile);
    const sourceRelative = toPosix(relative(repoRoot, sourcePath));

    components.push({
      sourcePath,
      sourceRelative,
      storyPath: getStoryPath(sourcePath),
      storyRelative: toPosix(relative(repoRoot, getStoryPath(sourcePath))),
      importPath: getImportPath(sourcePath),
      exportName,
      props,
      family: classifyComponent(sourceRelative, exportName),
      title: createStoryTitle(sourcePath, exportName),
      sourceText,
    });
  }

  return components;
}

async function readGeneratedStoryState(storyPath) {
  if (!existsSync(storyPath)) {
    return { exists: false };
  }

  const content = await readFile(storyPath, "utf8");
  const generated = content.includes(GENERATED_MARKER);
  const hashLine = content
    .split("\n")
    .find((line) => line.startsWith(SOURCE_HASH_PREFIX));

  return {
    exists: true,
    generated,
    sourceHash: hashLine?.slice(SOURCE_HASH_PREFIX.length).trim() ?? null,
    content,
  };
}

function resolveScanRoots(options) {
  if (!options.folder) {
    return defaultRoots;
  }

  const requested = resolve(repoRoot, options.folder);
  const uiSource = resolve(repoRoot, "packages/ui/src");

  if (!requested.startsWith(uiSource + sep) && requested !== uiSource) {
    throw new Error("--folder must resolve inside packages/ui/src");
  }

  return [requested];
}

function matchesComponentFilter(component, filter) {
  if (!filter) {
    return true;
  }

  const needle = filter.toLowerCase();
  return (
    component.exportName.toLowerCase().includes(needle) ||
    component.sourceRelative.toLowerCase().includes(needle)
  );
}

async function formatWithPrettier(paths) {
  if (paths.length === 0) {
    return;
  }

  try {
    const prettier = await import("prettier");

    for (const filePath of paths) {
      const source = await readFile(filePath, "utf8");
      const formatted = await prettier.format(source, {
        filepath: filePath,
      });
      await writeFile(filePath, formatted, "utf8");
    }
  } catch {
    // Prettier is optional. Generated output already follows repo conventions.
  }
}

async function main() {
  const options = parseArgs(process.argv.slice(2));

  if (options.help) {
    printHelp();
    return;
  }

  const roots = resolveScanRoots(options);
  const sourceFiles = (
    await Promise.all(roots.map((root) => walk(root)))
  ).flat();

  const discovered = (
    await Promise.all(sourceFiles.map(inspectComponentFile))
  )
    .flat()
    .filter((component) => matchesComponentFilter(component, options.component));

  const report = {
    generatedAt: new Date().toISOString(),
    mode: options.check ? "check" : options.dryRun ? "dry-run" : "write",
    roots: roots.map((root) => toPosix(relative(repoRoot, root))),
    totals: {
      sourceFiles: sourceFiles.length,
      components: discovered.length,
      created: 0,
      updated: 0,
      skippedExisting: 0,
      skippedAuthored: 0,
      unresolved: 0,
      missing: 0,
    },
    items: [],
  };

  const writtenPaths = [];

  for (const component of discovered) {
    const inferred = inferArgs(component);
    const currentHash = calculateHash(component.sourceText);
    const state = await readGeneratedStoryState(component.storyPath);

    if (inferred.unresolvedRequired.some((prop) => unsafeRequiredPropNames.has(prop.name))) {
      report.totals.unresolved += 1;
      report.items.push({
        component: component.exportName,
        source: component.sourceRelative,
        story: component.storyRelative,
        family: component.family,
        status: "unresolved",
        requiredProps: inferred.unresolvedRequired.map((prop) => prop.name),
      });
      continue;
    }

    if (state.exists && !options.force) {
      report.totals.skippedExisting += 1;
      report.items.push({
        component: component.exportName,
        source: component.sourceRelative,
        story: component.storyRelative,
        family: component.family,
        status: "skipped-existing",
      });
      continue;
    }

    if (state.exists && options.force) {
      if (!state.generated) {
        report.totals.skippedAuthored += 1;
        report.items.push({
          component: component.exportName,
          source: component.sourceRelative,
          story: component.storyRelative,
          family: component.family,
          status: "skipped-authored",
        });
        continue;
      }

      if (state.sourceHash && state.sourceHash !== currentHash) {
        report.totals.skippedAuthored += 1;
        report.items.push({
          component: component.exportName,
          source: component.sourceRelative,
          story: component.storyRelative,
          family: component.family,
          status: "skipped-modified-generated",
        });
        continue;
      }
    }

    const content = renderStory(component, currentHash, inferred);
    const action = state.exists ? "updated" : "created";

    if (options.check) {
      report.totals.missing += 1;
      report.items.push({
        component: component.exportName,
        source: component.sourceRelative,
        story: component.storyRelative,
        family: component.family,
        status: state.exists ? "stale-generated" : "missing",
      });
      continue;
    }

    if (!options.dryRun) {
      await mkdir(dirname(component.storyPath), { recursive: true });
      await writeFile(component.storyPath, content, "utf8");
      writtenPaths.push(component.storyPath);
    }

    report.totals[action] += 1;
    report.items.push({
      component: component.exportName,
      source: component.sourceRelative,
      story: component.storyRelative,
      family: component.family,
      status: options.dryRun ? `would-${action}` : action,
      confidence:
        inferred.unresolvedRequired.length === 0
          ? component.family === "generic"
            ? 1
            : 2
          : 3,
      unresolvedRequiredProps: inferred.unresolvedRequired.map(
        (prop) => prop.name,
      ),
    });
  }

  if (!options.dryRun && !options.check) {
    await formatWithPrettier(writtenPaths);
  }

  const reportPath = resolve(repoRoot, options.report);
  await mkdir(dirname(reportPath), { recursive: true });
  await writeFile(reportPath, `${JSON.stringify(report, null, 2)}\n`, "utf8");

  console.log(
    [
      `Components: ${report.totals.components}`,
      `Created: ${report.totals.created}`,
      `Updated: ${report.totals.updated}`,
      `Existing: ${report.totals.skippedExisting}`,
      `Unresolved: ${report.totals.unresolved}`,
      `Report: ${toPosix(relative(repoRoot, reportPath))}`,
    ].join("\n"),
  );

  if (options.check && report.totals.missing > 0) {
    process.exitCode = 1;
  }
}

main().catch((error) => {
  console.error(error instanceof Error ? error.message : error);
  process.exitCode = 1;
});
'''

