{
  "name": "rebel-apps",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "build:all": "turbo run build",
    "dev": "turbo run dev",
    "dev:packages": "turbo run dev --filter=./packages/*",
    "dev:app": "turbo run dev --filter=@apps/app",
    "dev:admin": "turbo run dev --filter=@apps/admin",
    "dev:docs": "turbo run dev --filter=@apps/docs",
    "dev:registry": "pnpm generate-registry && turbo run dev --filter=@apps/registry",
    "dev:storybook": "apps/storybook/node_modules/.bin/storybook dev -c apps/storybook/.storybook -p 6006 --host 0.0.0.0 --no-open",
    "generate-registry": "pnpm --filter=\"@apps/app\" exec node ./generate-registry.mjs",
    "storybook:stories:generate": "node apps/storybook/scripts/generate-stories.mjs",
    "storybook:stories:check": "node apps/storybook/scripts/generate-stories.mjs --check",
    "storybook:stories:repair": "node apps/storybook/scripts/repair-generated-stories.mjs",
    "dev:db": "turbo run dev --filter=@repo/db",
    "dev:ui": "turbo run dev --filter=@repo/ui",
    "clean": "rm -rf .turbo && pnpm -r exec sh -c 'rm -rf dist .next .turbo *.tsbuildinfo'",
    "clean:node_modules": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "lint": "turbo run lint",
    "lint:fix:docs": "pnpm --filter '@apps/docs' exec biome check --write .",
    "lint:fix:ui": "pnpm --filter '@repo/ui' lint:fix",
    "lint:show:issues":"pnpm --filter '@repo/ui' exec biome check src package.json --max-diagnostics=1000",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tailwindcss/postcss": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.9.4"
  },
  "dependencies": {
    "next": "^16.2.7"
  }
}

