commit 1fac40fdde82a59705a63353cba0d5a6de2aab54
Author: Gary Stringham <garystringham@macbookpro.revrebel.io>
Date:   Wed Aug 26 18:26:49 2026 -0700

    fix(ui): fix biome linter violations
    
    This commit fixes all the biome linter violations in the ui package, except for the storybook files and swapy.d.ts.
    
    The violations include noImgElement, useValidAnchor, noArrayIndexKey, useSemanticElements, noDuplicateCustomProperties, noExplicitAny, noSvgWithoutTitle, noUnusedVariables, noStaticElementInteractions.
    
    The fixes include replacing img tags with Image from next/image, using unique keys for mapped elements, using semantic elements like fieldset and input, removing duplicate custom properties, replacing any with more specific types, adding a title to svg elements, removing unused variables, and moving event handlers to the correct elements.

diff --git a/.github/workflows/ui-validation.yml b/.github/workflows/ui-validation.yml
new file mode 100644
index 00000000..c696deef
--- /dev/null
+++ b/.github/workflows/ui-validation.yml
@@ -0,0 +1,56 @@
+name: Validate UI Library
+
+on:
+  pull_request:
+    branches:
+      - dev
+    paths:
+      - "apps/storybook/**"
+      - "apps/registry/**"
+      - "packages/ui/**"
+      - "package.json"
+      - "pnpm-lock.yaml"
+      - "tsconfig.json"
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  validate:
+    name: Validate UI Package
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout Repo
+        uses: actions/checkout@v4
+
+      - name: Setup pnpm
+        uses: pnpm/action-setup@v4
+        with:
+          run_install: false
+
+      - name: Setup Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: "pnpm"
+
+      - name: Install Dependencies
+        run: pnpm install --frozen-lockfile
+
+      - name: Lint UI Package
+        run: pnpm --filter @repo/ui lint
+
+      - name: Check Barrel Files
+        run: pnpm --filter @repo/ui barrel:check
+
+      - name: Check Icon Exports
+        run: pnpm --filter @repo/ui icons:check
+
+      - name: Build Storybook
+        run: pnpm --filter @apps/storybook build
+
+      - name: Validate Registry
+        run: |
+          pnpm --filter @apps/registry registry:build
+          git diff --exit-code
